# DATABASE
DATABASE_URL=sqlite:///./data/instruments.db
# DATABASE_URL=postgresql://user:password@localhost/musicdb

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# SCRAPING
DEFAULT_TIMEOUT=30
MAX_RETRIES=3
HEADLESS_BROWSER=True
BROWSER_POOL_SIZE=5

# PROXY (round-robin rotation across the list)
# Entry formats: host:port | user:pass@host:port | http(s)://user:pass@host:port | socks5://host:port
# Scheme defaults to http. Use residential/mobile proxies for Cloudflare-protected sites.
USE_PROXY=False
PROXY_LIST=

# RATE LIMITING
DEFAULT_DELAY_BETWEEN_REQUESTS=3
REQUESTS_PER_MINUTE_DEFAULT=10

# CURRENCY
CURRENCY_API_KEY=
BASE_CURRENCY=EUR

# PRICING
MARGIN_MIN_PERCENT=5
MARGIN_MAX_PERCENT=15
PRICE_DISCOUNT_MULTIPLIER=0.93

# CACHE
CACHE_ENABLED=True
CACHE_TTL_HOURS=12

# SCHEDULER
SCHEDULER_ENABLED=True
TIMEZONE=Europe/Rome

# VISITOR LANGUAGE (optional offline GeoIP file, see README "Languages")
GEOIP_DB=data/dbip-country-lite.mmdb

# SEARCH RELEVANCE (local embedding model; empty = literal matching only)
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODELS_DIR=data/models

# CONTACT FORM — recipient and SMTP account. Keep real values only in .env
# (never committed). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURITY=starttls, SMTP_USER=<gmail address>, SMTP_PASSWORD=<app password>.
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=
CONTACT_RATE_LIMIT=3
CONTACT_RATE_WINDOW_S=600
